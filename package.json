{
  "name": "hono-boilerplate",
  "description": "boilerplate to run a js server using bun or node",
  "version": "1.7.0",
  "author": "Marcos <hello@marcosrjjunior.com>",
  "scripts": {
    "bun:build": "bun build src/bun.ts --compile --minify --target bun --outfile api",
    "bun:dev": "bun run --hot src/bun.ts",
    "bun:start": "./api",
    "dev": "bun run bun:dev",
    "node:dev": "bun run watch src/node.ts",
    "node:build": "tsc -p .",
    "node:start": "node ./dist/src/node.js",
    "test": "bun test .spec.ts",
    "test:integration": "bun test --preload ./src/tests/setup.ts .integration.test.ts",
    "db:migrate:up": "kysely migrate:latest",
    "db:migrate:down": "kysely migrate:down",
    "db:migrate:redo": "kysely migrate:rollback --all && bun run db:migrate:up && bun run db:generate:types",
    "db:migrate:make": "kysely migrate:make",
    "db:seed": "kysely seed:run",
    "db:reset": "bun run db:migrate:redo && bun run db:seed",
    "db:generate:types": "kysely-codegen --runtime-enums --out-file=./src/platform/persistence/schema.d.ts && bun run db:types:prettier",
    "db:types:prettier": "prettier --write ./src/platform/persistence/schema.d.ts",
    "check-types": "tsc --noemit --skipLibCheck",
    "lint": "oxlint ./src --type-aware --deny-warnings && bun run check-types",
    "lint:fix": "oxlint ./src --type-aware --fix",
    "prettier": "prettier --write ./src",
    "init": "kysely init"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "kysely-ctl": "^0.21.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
